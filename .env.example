# Fallback secret store, used ONLY if macOS Keychain is unavailable.
# Copy to .env (which git ignores) — never commit the real file.
# Normally you do not need this: `kit login tradestation` saves these in Keychain.
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_REFRESH_TOKEN=
